%% Erlang compiler options
{erl_opts, [
    warn_unused_vars,
    ewarn_export_all,
    warn_shadow_vars,
    warn_unused_import,
    warn_unused_function,
    warn_bif_clash,
    warn_unused_record,
    warn_deprecated_function,
    warn_obsolete_guard,
    strict_validation,
    warn_export_vars,
    warn_exported_vars,
    warn_missing_spec,
    debug_info,
    verbose,
    report_errors,
    report_warnings,
    time
]}.

{minimum_otp_vsn, "27"}.

{ex_doc, [
    {source_url, ~"https://github.com/inaka/mixer"},
    {extras, [~"README.md", ~"LICENSE"]},
    {main, ~"readme"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{project_plugins, [
    {rebar3_hex, "~> 7.1.0"},
    {erlfmt, "~> 1.8.0"},
    {rebar3_hank, "~> 2.0.0"},
    {rebar3_lint, "~> 6.0.0"},
    {rebar3_ex_doc, "~> 0.3.0"},
    rebar3_depup
]}.

{dialyzer, [
    {warnings, [
        no_return,
        unmatched_returns,
        error_handling,
        missing_return,
        extra_return,
        no_unknown
    ]}
]}.

{cover_enabled, true}.

{cover_opts, [verbose]}.

{erlfmt, [
    write, {files, ["include/*.hrl", "src/*.app.src", "src/*.erl", "test/*.erl", "*.config"]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]},
        {erl_first_files, ["test/foo.erl", "test/bar.erl"]}
    ]}
]}.

{alias, [{test, [fmt, hank, lint, dialyzer, eunit, {cover, "--verbose"}, ex_doc]}]}.
